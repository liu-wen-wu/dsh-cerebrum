{
  "name": "dsh-cerebrum",
  "version": "0.1.0",
  "description": "Brain-inspired cognitive architecture for DeepSeek Harness: hippocampal episodic memory, cortical semantic memory, spreading-activation recall, appraisal-based emotion, neuromodulator state, Big Five personality and dual-process judgment.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./service": "./lib/service.js",
    "./core/*": "./lib/core/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "dsh-cerebrum",
    "summary": "仿脑认知架构：海马情景记忆 + 幂律遗忘 + 情绪/性格/判断（10 工具 + 大脑面板 + 宠物接口）",
    "categories": ["记忆", "心智", "Web UI"],
    "surfaces": ["host", "web"],
    "capabilities": {
      "provides": ["service:cerebrum"]
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    },
    "permissions": {
      "network": []
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node scripts/load-check.mjs",
    "demo": "node examples/simulate.mjs",
    "dashboard": "node examples/dashboard.mjs",
    "retention": "node examples/retention.mjs",
    "forecast": "node examples/forecast.mjs",
    "pet": "node examples/pet-bridge.mjs",
    "pet-hook": "node examples/pet-hook.mjs",
    "privacy": "node scripts/privacy-check.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "cognition",
    "emotion",
    "personality",
    "neuromodulation",
    "hippocampus",
    "act-r"
  ],
  "license": "MIT"
}
